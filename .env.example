# Copy to .env for local dev; set these as environment variables in Coolify.

# Required. Base URL of the LiteLLM proxy's OpenAI-compatible API, reached
# over the WireGuard tunnel this container brings up itself (see wg/).
LITELLM_BASE_URL=http://10.1.0.155:4000/v1

# Required. A per-app LiteLLM virtual key scoped to only the vision model
# (not the master key) — generate with:
#   POST /key/generate {"models":["gemma4-e4b"],"key_alias":"punchcard"}
LITELLM_API_KEY=

# Optional. Model name as configured in LiteLLM. Default: gemma4-e4b
# LITELLM_MODEL=gemma4-e4b

# Optional. Per-attempt deadline in ms before giving up. Default: 30000
# LITELLM_TIMEOUT_MS=30000

# Optional. Attempts against the model before failing. Default: 2
# LITELLM_RETRIES=2

# Optional. Port the server listens on. Coolify sets this automatically.
# PORT=3000

# --- WireGuard tunnel (see wg/README.md) ---
# All required — docker-entrypoint.sh writes /etc/wireguard/wg0.conf from
# these and brings the tunnel up before starting the server.

# This deployment's own WireGuard private key.
WG_PRIVATE_KEY=

# This deployment's tunnel address, e.g. 10.8.0.3/32 (pick an unused one).
WG_ADDRESS=

# skynet's wg0 server public key (`wg show` on skynet).
WG_SERVER_PUBKEY=

# This peer's preshared key (generate with `wg genpsk`).
WG_PSK=

# skynet's public WireGuard endpoint.
WG_ENDPOINT=skynet.drewdettmer.com:51820

# Subnets reachable through the tunnel — the WG subnet itself plus skynet's LAN.
WG_ALLOWED_IPS=10.8.0.0/24, 10.1.0.0/24

# Optional.
# WG_DNS=1.1.1.1
# WG_KEEPALIVE=25

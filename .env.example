# Copy to .env for local dev; set these as environment variables in Coolify.

# Required. Google AI Studio API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional. Comma-separated model list, tried in order when the one before it
# is out of quota. Default:
# GEMINI_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite

# Optional. Port the server listens on. Coolify sets this automatically.
# PORT=3000
